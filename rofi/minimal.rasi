/* Rofi App Launcher - Com Transparência Suave */

configuration {
    modi:                       "drun";
    show-icons:                 true;
    icon-theme:                 "Papirus";
    display-drun:               ">_";
    drun-display-format:        "{name}";
}

* {
    /* #121314 com 92% de opacidade (eb em hex) igual ao Waybar */
    bg-col:                     #121314eb; 
    fg-col:                     #b5b8ba;
    accent-col:                 #6c8fa8;
    
    background-color:           transparent;
    text-color:                 @fg-col;
    font:                       "Terminus (TTF) 9";
}

window {
    height:                     400px;
    width:                      300px;
    border:                     0px;
    border-radius:              0px;
    background-color:           @bg-col;
    padding:                    10px;
}

mainbox {
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
    spacing:                    8px;
}

inputbar {
    background-color:           transparent;
    padding:                    2px 4px;
    children:                   [ "entry" ];
}

entry {
    background-color:           transparent;
    text-color:                 @fg-col;
    placeholder:                "pesquisar...";
    placeholder-color:          #3f4d5a;
    cursor:                     pointer;
}

listview {
    background-color:           transparent;
    columns:                    1;
    lines:                      12;
    spacing:                    1px;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
}

element {
    background-color:           transparent;
    text-color:                 @fg-col;
    orientation:                horizontal;
    border-radius:              0px;
    padding:                    1px 6px;
    spacing:                    8px;
}

element-icon {
    size:                       14px;
    background-color:           transparent;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    vertical-align:             0.5;
}

element selected {
    background-color:           #6c8fa826; /* Seleção transparente com azul */
    text-color:                 @accent-col;
}
